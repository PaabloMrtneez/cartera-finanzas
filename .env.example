# Copia este fichero a .env.local y rellena los valores.
# .env.local está en .gitignore y NUNCA debe subirse al repositorio.

# --- Supabase ---------------------------------------------------------------
# Panel de Supabase → Project Settings → API

# Estas dos van al navegador. Son públicas por diseño: lo que protege los datos
# es la seguridad a nivel de fila, no que estas claves sean secretas.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Esta NO lleva prefijo NEXT_PUBLIC_ a propósito: salta toda la seguridad por
# filas y da acceso completo a los datos de los cuatro usuarios. Solo se usa en
# el servidor (la ingesta del Atajo, los precios de mercado y generar enlaces de
# invitación). Si alguna vez se filtra, rótala inmediatamente desde el panel de
# Supabase.
SUPABASE_SERVICE_ROLE_KEY=

# --- Invitaciones -----------------------------------------------------------
# Quién puede invitar desde Ajustes → «Invitar a alguien»: los id de usuario
# (uuid de Supabase → Authentication → Users), separados por comas. Sin valor,
# la sección no aparece para nadie. Es del SERVIDOR: sin prefijo NEXT_PUBLIC_.
CARTERA_ADMIN_IDS=

# Cuántas horas dura un enlace de invitación, SOLO para avisarlo en pantalla.
# La caducidad de verdad la decide Supabase (Authentication → Sign In / Providers
# → Email → «Email OTP Expiration»); pon aquí lo mismo. Vacío = 1 hora.
CARTERA_ENLACE_CADUCA_HORAS=

# --- Notificaciones push ----------------------------------------------------
# Genera el par con: node -e "console.log(require('web-push').generateVAPIDKeys())"
#
# La pública va al navegador y no es secreta. La privada firma los envíos y no
# sale del servidor: si se filtra, cualquiera podría mandar notificaciones a tus
# dispositivos.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@correo.com

# Protege /api/notificar para que solo la tarea programada pueda dispararla.
# Tiene que valer lo mismo que el secreto NOTIFY_SECRET del repositorio.
NOTIFY_SECRET=

# --- Secretos de GitHub Actions (no van aquí, se configuran en el repo) ------
# Repositorio → Settings → Secrets and variables → Actions
#
#   SUPABASE_DB_URL     Cadena de conexión de Postgres. Panel de Supabase →
#                       Project Settings → Database → Connection string (URI).
#                       La usan las tareas de mantenimiento y de copia de seguridad.
#
#   BACKUP_PASSPHRASE   Contraseña larga y aleatoria para cifrar los volcados.
#                       Guárdala en tu gestor de contraseñas: sin ella, las
#                       copias de seguridad son irrecuperables.
#
#   NOTIFY_SECRET       El mismo valor que arriba, para que la tarea de avisos
#                       pueda llamar a /api/notificar.
#
#   APP_URL             Dominio público de la app, sin barra final.
